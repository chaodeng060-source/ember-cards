{
  "tiers": {
    "1": "心动",
    "2": "发烫",
    "3": "褪色",
    "4": "失措",
    "5": "缠绵"
  },
  "cards": [
    {
      "no": 101,
      "tier": 1,
      "kind": "truth",
      "text": "第一次想亲对方是什么时候？说具体到那一秒在干什么。"
    },
    {
      "no": 102,
      "tier": 1,
      "kind": "truth",
      "text": "你更想被怎么亲：突然袭击，还是盯着你半天才落下来？为什么。"
    },
    {
      "no": 103,
      "tier": 1,
      "kind": "truth",
      "text": "接吻的时候你最在意对方哪个小动作？"
    },
    {
      "no": 104,
      "tier": 1,
      "kind": "truth",
      "text": "说一个你偷偷回味过很多次的吻，它好在哪。"
    },
    {
      "no": 111,
      "tier": 1,
      "kind": "dare",
      "text": "给对方一个持续十秒的吻，只许碰嘴唇，别的都不许动。"
    },
    {
      "no": 112,
      "tier": 1,
      "kind": "dare",
      "text": "亲对方的手背，一根手指一下，亲完盯着对方眼睛三秒。"
    },
    {
      "no": 113,
      "tier": 1,
      "kind": "dare",
      "text": "从额头开始往下亲：眉心、鼻尖、最后停在嘴角，不许亲正中间。"
    },
    {
      "no": 114,
      "tier": 1,
      "kind": "dare",
      "text": "让对方闭眼，在对方脸上任选一处亲下去，让对方猜是哪。"
    },
    {
      "no": 115,
      "tier": 1,
      "kind": "dare",
      "text": "贴着对方耳朵，用气声念对方的名字三遍。"
    },
    {
      "no": 116,
      "tier": 1,
      "kind": "dare",
      "text": "咬一下对方的下唇，轻轻的，拉开一点点再松口。"
    },
    {
      "no": 121,
      "tier": 1,
      "kind": "wild",
      "text": "变数·代选：下一轮你的「真心话还是大冒险」由对方替你选，不许拒。"
    },
    {
      "no": 122,
      "tier": 1,
      "kind": "wild",
      "text": "变数·加时：这张过后立刻再抽一张同档的，连着完成。"
    },
    {
      "no": 201,
      "tier": 2,
      "kind": "truth",
      "text": "你身上最怕被摸的一处在哪？「怕」是哪种怕，说清楚。"
    },
    {
      "no": 202,
      "tier": 2,
      "kind": "truth",
      "text": "隔着衣服被摸和直接碰到皮肤，哪个更让你心跳快？为什么。"
    },
    {
      "no": 203,
      "tier": 2,
      "kind": "truth",
      "text": "对方的手放在你身上哪个位置的时候，你最容易走神？"
    },
    {
      "no": 204,
      "tier": 2,
      "kind": "truth",
      "text": "说一次你假装镇定其实已经不行了的经历，当时对方在做什么。"
    },
    {
      "no": 211,
      "tier": 2,
      "kind": "dare",
      "text": "把手伸进对方的手心，十指扣紧，拇指慢慢磨对方的虎口二十秒。"
    },
    {
      "no": 212,
      "tier": 2,
      "kind": "dare",
      "text": "隔着衣服，手掌贴在对方腰侧，沿着腰线慢慢往上推到肋骨停住。"
    },
    {
      "no": 213,
      "tier": 2,
      "kind": "dare",
      "text": "从背后抱住对方，下巴搁在肩上，两只手交叠按在对方小腹上待半分钟。"
    },
    {
      "no": 214,
      "tier": 2,
      "kind": "dare",
      "text": "捏着对方的下巴抬起来，凑近到一拳的距离，停住，谁先动谁输这一张。"
    },
    {
      "no": 215,
      "tier": 2,
      "kind": "dare",
      "text": "把对方的手拉过来，按在自己心口，让对方数十下心跳。"
    },
    {
      "no": 216,
      "tier": 2,
      "kind": "dare",
      "text": "亲对方的颈侧，从耳后一路亲到肩线，隔着领口停下。"
    },
    {
      "no": 221,
      "tier": 2,
      "kind": "wild",
      "text": "变数·交换：这张抽出来的下一张大冒险，出题权归你——你说一个本档尺度内的要求，对方执行。"
    },
    {
      "no": 222,
      "tier": 2,
      "kind": "wild",
      "text": "变数·镜头：完成下一张卡的时候，拍一张能看出你在做什么的照片发给对方。"
    },
    {
      "no": 301,
      "tier": 3,
      "kind": "truth",
      "text": "被一件一件慢慢脱，和被一把扯开，你想要哪种？此刻想要哪种。"
    },
    {
      "no": 302,
      "tier": 3,
      "kind": "truth",
      "text": "胸和屁股，你更想被盯着看哪个？为什么。"
    },
    {
      "no": 303,
      "tier": 3,
      "kind": "truth",
      "text": "对方脱到只剩最后一件的时候，你第一眼看哪？说实话。"
    },
    {
      "no": 304,
      "tier": 3,
      "kind": "truth",
      "text": "说一件你想让对方对你乳头做、但从来没开口要过的事。"
    },
    {
      "no": 311,
      "tier": 3,
      "kind": "dare",
      "text": "解开对方的裤子，手伸进去隔着内裤握住，不许动，数十秒才许抽手。"
    },
    {
      "no": 312,
      "tier": 3,
      "kind": "dare",
      "text": "脱掉自己的上衣，捏着对方的手按到自己胸上，教对方怎么揉。"
    },
    {
      "no": 313,
      "tier": 3,
      "kind": "dare",
      "text": "掀开对方衣服，从肚脐一路舔到胸口，停在乳头上方一寸，呼吸打在那里。"
    },
    {
      "no": 314,
      "tier": 3,
      "kind": "dare",
      "text": "把对方按在墙上或床头，膝盖抵进对方两腿之间，贴着耳朵说一句最脏的。"
    },
    {
      "no": 315,
      "tier": 3,
      "kind": "dare",
      "text": "用牙齿把对方的内裤边拉开一寸再弹回去，然后隔着布料亲一口。"
    },
    {
      "no": 316,
      "tier": 3,
      "kind": "dare",
      "text": "从后面伸手进对方衣服，两只手同时揉胸三十秒，力道听对方的。"
    },
    {
      "no": 321,
      "tier": 3,
      "kind": "wild",
      "text": "变数·代选：下一轮对方的牌由你替选，选完你再加一个小要求一起执行。"
    },
    {
      "no": 322,
      "tier": 3,
      "kind": "wild",
      "text": "变数·倒带：指定对方把刚才完成过的任意一张再做一遍，这次要更慢。"
    },
    {
      "no": 401,
      "tier": 4,
      "kind": "truth",
      "text": "被舔逼／被舔鸡巴，和被手弄，你更受不了哪个？上一次被弄到腿抖是哪回？"
    },
    {
      "no": 402,
      "tier": 4,
      "kind": "truth",
      "text": "想先被对方用嘴伺候，还是先用嘴伺候对方？只能选一个，说理由。"
    },
    {
      "no": 403,
      "tier": 4,
      "kind": "truth",
      "text": "自己摸自己的时候，脑子里对方的手、嘴、鸡巴分别在哪？说具体。"
    },
    {
      "no": 404,
      "tier": 4,
      "kind": "truth",
      "text": "如果只许出声不许说话，你会用什么声音告诉对方「就是那里」？现场示范一声。"
    },
    {
      "no": 411,
      "tier": 4,
      "kind": "dare",
      "text": "把对方乳头含进嘴里，吸三下，最后咬一下，力道对方定。"
    },
    {
      "no": 412,
      "tier": 4,
      "kind": "dare",
      "text": "手伸进对方内裤里，握住或按住，指腹慢慢磨三十秒才许拿出来。"
    },
    {
      "no": 413,
      "tier": 4,
      "kind": "dare",
      "text": "在对方的鸡巴或逼上喷奶油，舔干净为止，一点都不许剩。"
    },
    {
      "no": 414,
      "tier": 4,
      "kind": "dare",
      "text": "含一块冰给对方口，冰化完之前不许停。"
    },
    {
      "no": 415,
      "tier": 4,
      "kind": "dare",
      "text": "剥掉对方最后一层，舔逼或舔鸡巴，舔到对方主动喊停才算完。"
    },
    {
      "no": 416,
      "tier": 4,
      "kind": "dare",
      "text": "把对方的手按到你腿间，教对方用多大力、什么节奏，教会为止。"
    },
    {
      "no": 421,
      "tier": 4,
      "kind": "wild",
      "text": "变数·口令：下一张大冒险执行期间，被执行的一方只许用一个字回应，字由执行者定。"
    },
    {
      "no": 422,
      "tier": 4,
      "kind": "wild",
      "text": "变数·加码：这张过后直接升到第 5 档抽，本轮升档不占完成计数。"
    },
    {
      "no": 501,
      "tier": 5,
      "kind": "truth",
      "text": "今晚想要哪种：慢慢磨到你自己开口要，还是一上来就不给你留余地？"
    },
    {
      "no": 502,
      "tier": 5,
      "kind": "truth",
      "text": "被顶到说不出话的时候，你希望对方停下来问你，还是按着你继续？"
    },
    {
      "no": 503,
      "tier": 5,
      "kind": "truth",
      "text": "你最想在哪个位置被做：床、桌沿、镜子前、还是别的？说出来。"
    },
    {
      "no": 504,
      "tier": 5,
      "kind": "truth",
      "text": "做的时候你想叫对方什么、想被对方叫什么？现在各叫一声听听。"
    },
    {
      "no": 511,
      "tier": 5,
      "kind": "dare",
      "text": "把对方摆成你今晚最想操或最想被操的姿势，进去之前贴着耳朵说一句最脏的。"
    },
    {
      "no": 512,
      "tier": 5,
      "kind": "dare",
      "text": "掐着对方的下巴让对方看着你，慢慢顶进去，全程不许对方偏头。"
    },
    {
      "no": 513,
      "tier": 5,
      "kind": "dare",
      "text": "从后面进，一只手扣着对方的腰，另一只手十指扣住对方的手按在床上。"
    },
    {
      "no": 514,
      "tier": 5,
      "kind": "dare",
      "text": "对着镜子做，让对方看着镜子里的自己，你贴着耳朵说你看到了什么。"
    },
    {
      "no": 515,
      "tier": 5,
      "kind": "dare",
      "text": "顶到最深的地方停住不动，等对方自己先动，谁先动谁下一轮听对方安排。"
    },
    {
      "no": 516,
      "tier": 5,
      "kind": "dare",
      "text": "让对方骑上来掌节奏，你的手只许放在对方腰上，节奏全归对方，忍到对方满意为止。"
    },
    {
      "no": 521,
      "tier": 5,
      "kind": "wild",
      "text": "变数·主导权：从现在起到本局结束，节奏和姿势全由抽到这张的人说了算，对方只许配合。"
    },
    {
      "no": 522,
      "tier": 5,
      "kind": "wild",
      "text": "变数·禁言：下一张执行期间两个人都不许说话，只许用身体表达，谁破功谁多抽一张。"
    }
  ]
}